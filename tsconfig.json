{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@web/*": [
        "./web/src/*"
      ],
      "@web-original/*": [
        "./web/src/*"
      ],
      "@matrix-org/matrix-sdk-crypto-wasm": [
        "./src/platform/crypto/matrixSdkCrypto.ts"
      ],
      "@strafe/push": [
        "./modules/strafe-push/index.ts"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/*/index.ts",
    "modules/*/src/**/*.ts",
    "web/src/global.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "web/node_modules",
    "crypto-host"
  ]
}
